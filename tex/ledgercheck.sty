% ledgercheck.sty -- root hash and status table of the evidence ledger (trust-ledger).
%
%   \usepackage[paper=NAME]{ledgercheck}
%
% reads two files that `ledger.py -P NAME tex` writes into the ledger's generated directory
% (found through TEXINPUTS):
%   ledger-NAME-root.tex     the root hash and where it was sealed
%   ledger-NAME-status.tex   per-result status and the counts for the banner
% Both are excluded from the hashed source, so the root can be printed in the document
% it covers. Nothing is typed by hand.
%
% Options
%   paper=NAME   ledger scope (a paper name of ledger/ledger.toml). Without it the package
%                does nothing and reads no file: the plain, submission-ready copy.
%   auto=1|0     1 (default): the appendix "Evidence ledger" is added at the end of the
%                document unless \ledgerappendix was called; 0: only on request.
%
% Commands
%   \ledgerappendix    the appendix: status banner, root, explanation, how to check, table
%   \ledgertitlenote   inside \title{...}: a footnote "Evidence ledger root ..." 
%   \ledgerrootshort   the first 12 hex digits of the root (or "unsealed")
%
% Without a root file (a draft) the appendix says "UNSEALED DRAFT" instead of a hash, so a
% draft cannot be mistaken for a sealed paper. Colour is always accompanied by a word.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ledgercheck}[2026/10/11 v0.2 evidence ledger root and status]

\RequirePackage{kvoptions}
\RequirePackage{xcolor}
\RequirePackage{booktabs,array}
\SetupKeyvalOptions{family=ledgercheck,prefix=ledgercheck@}
\DeclareStringOption[]{paper}
\DeclareStringOption[1]{auto}
\ProcessKeyvalOptions*

\newif\ifledgercheck@on
\newif\ifledgercheck@sealed
\newif\ifledgercheck@placed
\newif\ifledgercheck@wastwocolumn
% the flag is only reliable here, while the class options are in force (as in leancheck.sty)
\if@twocolumn\ledgercheck@wastwocolumntrue\else\ledgercheck@wastwocolumnfalse\fi
\ifx\ledgercheck@paper\@empty\ledgercheck@onfalse\else\ledgercheck@ontrue\fi

\definecolor{ledgergreen}{rgb}{0.05,0.35,0.10}
\definecolor{ledgeryellow}{rgb}{0.80,0.40,0.00}
\definecolor{ledgerred}{rgb}{0.70,0.15,0.15}

% ---- files ---------------------------------------------------------------
\ifledgercheck@on
  % found through TEXINPUTS (working tree) or in ./ledger/ next to the paper (a release)
  \newcommand{\ledgercheck@input}[2]{%
    \IfFileExists{ledger-\ledgercheck@paper-#1.tex}{\input{ledger-\ledgercheck@paper-#1.tex}#2}{%
      \IfFileExists{ledger/ledger-\ledgercheck@paper-#1.tex}{\input{ledger/ledger-\ledgercheck@paper-#1.tex}#2}{}}}
  \AtBeginDocument{%
    \ledgercheck@input{root}{\ledgercheck@sealedtrue}%
    \ledgercheck@input{status}{}%
  }
\fi

% ---- cells ---------------------------------------------------------------
\newcommand{\LedgerNoAtt}{\textit{not yet attested}}
% \LedgerAtt{level}{person}{date}{current|stale}{signature state}: two lines, level/date/status above the person.
% \LedgerAtts stacks several of them in a nested tabular aligned at its top line with the rest of the row.
\newcommand{\LedgerAtts}[1]{\begin{tabular}[t]{@{}l@{}}#1\end{tabular}}
\newcommand{\LedgerAtt}[5]{%
  \csname ledgercheck@lvl@#1\endcsname\ #3\csname ledgercheck@st@#4\endcsname\\
  #2\csname ledgercheck@sig@#5\endcsname}
\newcommand{\ledgercheck@sig@signed}{\ {\scriptsize[signed]}}
\newcommand{\ledgercheck@sig@unsigned}{}
\expandafter\newcommand\csname ledgercheck@sig@unknown-key\endcsname{}
\newcommand{\ledgercheck@sig@unchecked}{\ {\scriptsize[signature unchecked]}}
\newcommand{\ledgercheck@sig@invalid}{}
\newcommand{\ledgercheck@sig@revoked}{}
\newcommand{\LedgerKeyRow}[4]{#1 & \texttt{#2} & #3 #4 \\}
\newcommand{\ledgercheck@lvl@green}{{\color{ledgergreen}\textbf{GREEN}}}
\newcommand{\ledgercheck@lvl@yellow}{{\color{ledgeryellow}\textbf{YELLOW}}}
\newcommand{\ledgercheck@lvl@conjecture}{{\color{ledgerred}\textbf{CONJECTURE}}}
\newcommand{\ledgercheck@st@current}{}
\newcommand{\ledgercheck@st@stale}{\ {\color{ledgerred}\textbf{STALE}}}
% a result shown given hypotheses: [H1, H2] in a tool cell are keys into the Hypotheses table
\newcommand{\LedgerHypRow}[5]{#1 & \ledgercheck@mb{2.0cm}{#2} & \ledgercheck@mb{3.6cm}{#3} & \ledgercheck@mb{4.6cm}{#4} & #5 \\}
% tool columns (one per tool the ledger uses, titles and texts from the tools' adapters): a neutral style,
% never the attestation colours. \LedgerToolCell{status}{text}, status ok|conditional|open|failed|missing|none;
% a failed check is a finding about the result, shown plainly, not as an alarm
\newcommand{\LedgerToolCell}[2]{\ledgercheck@mb{\LedgerToolWidth}{\csname ledgercheck@tool@#1\endcsname{#2}}}
\newcommand{\ledgercheck@tool@ok}[1]{#1}
\newcommand{\ledgercheck@tool@conditional}[1]{#1}
\newcommand{\ledgercheck@tool@open}[1]{#1}
\newcommand{\ledgercheck@tool@failed}[1]{\textbf{#1}}
\newcommand{\ledgercheck@tool@missing}[1]{\textbf{not in the dump}}
\newcommand{\ledgercheck@tool@none}[1]{---}
% fixed cell widths keep the columns aligned from chunk to chunk; the attestation column is last, so
% a long entry runs into the margin instead of into another column
\newcommand{\ledgercheck@mb}[2]{\makebox[#1][l]{#2}}
% \LedgerRow{result}{evidence}{statement source}{&cell&cell...}{register}{attestation}: the fourth argument
% brings its own column separators, one cell per tool
\newcommand{\LedgerRow}[6]{%
  \ledgercheck@mb{\LedgerResultWidth}{#1} & \ledgercheck@mb{1.1cm}{#2 #3} #4 &
  \ledgercheck@mb{0.5cm}{#5} & #6 \\}
% the status table comes in chunks, each a plain tabular with its own header (neither longtable nor
% supertabular nor p-columns work in the two-column quantumarticle class); pages break between chunks
\newcommand{\LedgerTable}[1]{\par\noindent{\setlength{\tabcolsep}{3pt}%
  \edef\ledgercheck@cols{@{}ll\LedgerToolCols ll@{}}%
  \expandafter\ledgercheck@table\expandafter{\ledgercheck@cols}{#1}}\par\vskip 4pt plus 6pt}
\newcommand{\ledgercheck@table}[2]{%
  \begin{tabular}{#1}
    \toprule Result & Ev. Stmt. \LedgerToolHead & Reg. & Attestation\\ \midrule
    #2
    \bottomrule
  \end{tabular}}

% ---- marker ---------------------------------------------------------------
\newcommand{\ledgerrootshort}{%
  \ifledgercheck@on\ifledgercheck@sealed\texttt{\LedgerRootShort}\else unsealed\fi\fi}
\newcommand{\ledgertitlenote}{%
  \ifledgercheck@on\thanks{Evidence ledger root \ledgerrootshort; see the section
    ``Evidence ledger'' at the end of this paper.}\fi}

% ---- appendix ---------------------------------------------------------------
\newcommand{\ledgercheck@banner}{%
  Of \LedgerNClaims{} results in the ledger:
  \LedgerNGreen{} \ledgercheck@lvl@green, \LedgerNYellow{} \ledgercheck@lvl@yellow,
  \LedgerNConj{} \mbox{\ledgercheck@lvl@conjecture} (a different kind of statement, not a worse grade);
  \LedgerNStale{} with only \ledgercheck@st@stale{} attestations; \LedgerNNone{} not yet attested.
  \ifnum\LedgerNConditional>0 Machine checks: \LedgerNConditional{} hold given a hypothesis that is assumed, not
  proved.\fi
  \ifnum\LedgerNOpen>0 \LedgerNOpen{} have an open item in a machine check (an unfinished proof, an extra axiom,
  an inconclusive result).\fi
  \ifnum\LedgerNFailed>0 \LedgerNFailed{} have a failed or missing machine check.\fi
  \ifnum\LedgerNAtt>0 \LedgerNSignedAtt{} of \LedgerNAtt{} attestations carry a valid signature.\fi}

\newcommand{\ledgerappendix}{%
  \ledgercheck@placedtrue
  \ifledgercheck@on
  \ifledgercheck@wastwocolumn\clearpage\onecolumn\fi
  \section*{Evidence ledger}
  \ifledgercheck@sealed
    \par\noindent\textbf{Status.}\ \ledgercheck@banner
    \par\medskip\noindent\textbf{Root hash} (SHA-256, sealed \LedgerDate, ledger format \LedgerFormat):
    \begin{center}\ttfamily\small
      \LedgerRootA\\\LedgerRootB\\\LedgerRootC\\\LedgerRootD
    \end{center}
    \noindent The root is a Merkle hash over the evidence behind each result as recorded by the tools that
    checked it (\LedgerToolNames), the data and processing steps it rests on, the statements of the results
    as typeset in this paper, the assumptions and cited hypotheses, the assertions made by the authors, the
    attestations given by named persons, the environment (tool versions), and the source of this paper
    (hash \texttt{\LedgerSource}, excluding the files that show the root and this table). Changing any of
    these changes the root. Supplementary data (ledger files, sources, verification tool): \LedgerSupplement.

    \par\medskip\noindent\textbf{What it does and does not establish.}
    The root shows that the data in the supplement is exactly the data this table was derived from.
    It does not show that a formal statement means what the text means; that is what attestations are
    for. An attestation records a person, a date and the checklist items that person did; it is bound
    to the hash of the statement as typeset, and is shown as \ledgercheck@st@stale{} when the statement
    has changed since. GREEN: the named author has personally done the checklist and stands behind the
    result. YELLOW: convinced and the gap repairable, but would not yet defend it against experts.
    CONJECTURE: a claim without proof. The tool columns are machine checks and are shown in a neutral
    style.

    \par\medskip\noindent\textbf{How to check.}
    Recompute all hashes from the supplement and compare with the root above:
    \texttt{\LedgerVerify}. To also re-derive what the tools recorded, rerun them from the sources in the
    supplement (\texttt{ledger.py extract}, \texttt{ledger.py check}; see its README), then run the same command.

    \par\medskip
    {\scriptsize\LedgerChunks}
    \ifdefined\LedgerNHyp\ifnum\LedgerNHyp>0
      \par\medskip\noindent\textbf{Hypotheses.} Results marked \emph{given} [H1] are shown by a tool given the
      hypothesis H1 of the table below, a statement that is assumed there, not proved. If it is a known theorem of the literature, a named
      person can attest that: they found the cited statement, compared it with the formal definition and
      checked that the conditions match. The attestation is bound to the hash of the statement in this paper, the
      formal definition and the cited sources, so it becomes \ledgercheck@st@stale{} when any of them changes. It does not
      make the hypothesis a machine-checked proof; it says who vouches that the assumption is a theorem.
      Currently \LedgerNHypKnown{} of \LedgerNHyp{} hypotheses are attested as known theorems.\par\smallskip
      {\footnotesize\noindent\begin{tabular}{@{}lllll@{}}
        \toprule Key & In this paper & Formal hypothesis & Cited & Attested as known theorem\\ \midrule
        \LedgerHyps
        \bottomrule\end{tabular}}\par\medskip
    \fi\fi
    \ifdefined\LedgerNSplit\ifnum\LedgerNSplit>0
      \par\medskip\noindent\textbf{Split results.} \LedgerNSplit{} results of this paper are stated by more than one
      ledger entry, each covering a part; such a result is attested only when every part is: \LedgerSplit.
    \fi\fi
    \ifnum\LedgerNUncovered>0
      \par\medskip\noindent\textbf{Not in the ledger.} \LedgerNUncovered{} labelled theorem-like results of this
      paper have no entry in the ledger, so nothing is claimed about them here: \LedgerUncovered.
    \fi
    \ifnum\LedgerNKeys>0
      \par\medskip\noindent\textbf{Keys.} Signatures are optional and use OpenSSH keys. A key is introduced
      by this paper (the authors' keys), by vouching, or by a recorded source such as a homepage; there is no
      certificate authority, so the binding of a key to a person rests on this list being published under
      the authors' names.\par\smallskip
      {\footnotesize\noindent\begin{tabular}{@{}lll@{}} Person & Fingerprint & Introduced by\\\midrule
        \LedgerKeys\end{tabular}}\par\medskip
    \fi
    \ifnum\LedgerNChecklist>0
      \par\medskip\noindent\textbf{Checklist.} An attestation lists the items of this checklist that the person
      has done: \LedgerChecklist.\par\medskip
    \fi
    \noindent Ev.: evidence type, \LedgerEvidenceLegend. Stmt.: \texttt{tex} = taken from this paper's source
    by its label, \texttt{manual} = written in the ledger. \LedgerToolLegend{} --- = no evidence of that kind.
    Reg.: number of open assumptions on which the result rests (assumed hypotheses, cited results, data taken
    as given, manual steps, assertions). A result covering several labels appears once per label.
  \else
    \par\noindent{\color{ledgerred}\textbf{UNSEALED DRAFT.}} No ledger root file
    (\texttt{ledger-\ledgercheck@paper-root.tex}) was found; run
    \texttt{ledger.py -P \ledgercheck@paper\ tex}.
  \fi
  \ifledgercheck@wastwocolumn\clearpage\twocolumn\fi
  \fi}
\def\ledgercheck@zero{0}
\AtEndDocument{\ifledgercheck@on\ifledgercheck@placed\else
  \ifx\ledgercheck@auto\ledgercheck@zero\else\ledgerappendix\fi\fi\fi}
